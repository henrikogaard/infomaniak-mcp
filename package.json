{
  "name": "@henrikogard/infomaniak-mcp",
  "version": "1.1.0",
  "description": "Unified MCP server for Infomaniak kSuite — kDrive, Calendar, Tasks, Mail, Contacts, kChat, kMeet, Chk, kPaste, AI Tools, and Swiss Transfer",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-infomaniak": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "bench:readonly": "node scripts/bench-readonly.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "smoke:readonly": "node scripts/smoke-readonly.mjs",
    "smoke:write-owned": "node scripts/smoke-owned-write.mjs",
    "swisstransfer:helper": "node scripts/swisstransfer-token-helper.mjs"
  },
  "keywords": [
    "mcp",
    "infomaniak",
    "ksuite",
    "kdrive",
    "calendar",
    "tasks",
    "caldav",
    "mail",
    "contacts",
    "carddav"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henrikogaard/infomaniak-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/henrikogaard/infomaniak-mcp/issues"
  },
  "homepage": "https://github.com/henrikogaard/infomaniak-mcp#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "^16.6.1",
    "ical.js": "^2.2.1",
    "imapflow": "^1.3.6",
    "mailparser": "^3.9.9",
    "nodemailer": "^8.0.10",
    "tsdav": "^2.1.8",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.0",
    "typescript": "^5.8.3"
  }
}
